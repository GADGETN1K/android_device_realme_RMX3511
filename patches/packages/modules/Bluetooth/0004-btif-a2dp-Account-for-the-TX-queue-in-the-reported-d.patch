From 102811dcd2c54002c560e71212d302f29787ab9c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 16 Oct 2026 20:22:52 +0300
Subject: [PATCH 4/4] btif: a2dp: Account for the TX queue in the reported
 delay

Audio waiting in the A2DP source TX queue is not part of the delay the
audio HAL reports to the framework, so when the queue backs up (for
instance while Wi-Fi holds a 2.4 GHz antenna shared with Bluetooth),
audio falls behind video and nothing corrects it.

Keep the PCM byte count behind every queued packet (the bytes_read the
encoder already passes in), derive the stream's PCM rate from the
session, and on every encoder tick report the sink delay plus the
queue's play time through set_remote_delay(). Players that sync on
AudioTrack timestamps then hold video back by the same amount. Updates
smaller than 5 ms are skipped.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WBs6XUfh1pxQ1q9QJe6TLW
---
 system/btif/src/btif_a2dp_source.cc | 88 ++++++++++++++++++++++++++++-
 1 file changed, 87 insertions(+), 1 deletion(-)

diff --git a/system/btif/src/btif_a2dp_source.cc b/system/btif/src/btif_a2dp_source.cc
index 7eaf0e1..2c9cd36 100644
--- a/system/btif/src/btif_a2dp_source.cc
+++ b/system/btif/src/btif_a2dp_source.cc
@@ -34,8 +34,10 @@
 #include <chrono>
 #include <cstdint>
 #include <cstring>
+#include <deque>
 #include <future>
 #include <iomanip>
+#include <mutex>
 #include <string>
 #include <utility>
 #include <vector>
@@ -252,6 +254,82 @@ static bluetooth::common::MessageLoopThread btif_a2dp_source_thread(
 static BtifA2dpSource btif_a2dp_source_cb;
 static uint8_t btif_a2dp_source_dynamic_audio_buffer_size = MAX_OUTPUT_A2DP_FRAME_QUEUE_SZ;
 
+/**
+ * Audio held in the TX queue is not part of the delay the audio HAL reports,
+ * so a TX queue that backs up (e.g. while Wi-Fi holds the shared antenna)
+ * makes audio lag video. Track how much PCM each queued packet carries and
+ * add the queue's play time to the remote delay reported to the HAL.
+ */
+class TxQueueDelay {
+public:
+  void Clear() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    pcm_bytes_.clear();
+    queued_bytes_ = 0;
+  }
+
+  void StartSession(uint64_t now_us) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    pcm_bytes_.clear();
+    queued_bytes_ = 0;
+    session_bytes_ = 0;
+    session_start_us_ = now_us;
+    last_reported_ = 0;
+  }
+
+  void Enqueued(uint32_t bytes) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    pcm_bytes_.push_back(bytes);
+    queued_bytes_ += bytes;
+    session_bytes_ += bytes;
+  }
+
+  void Dequeued() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (pcm_bytes_.empty()) {
+      return;
+    }
+    queued_bytes_ -= pcm_bytes_.front();
+    pcm_bytes_.pop_front();
+  }
+
+  // Report the sink delay plus the play time of the TX queue to the audio
+  // HAL, in the 1/10 ms units of the AVDTP delay report.
+  void Report(uint64_t now_us) {
+    uint64_t queued_bytes, session_bytes, start_us;
+    {
+      std::lock_guard<std::mutex> lock(mutex_);
+      queued_bytes = queued_bytes_;
+      session_bytes = session_bytes_;
+      start_us = session_start_us_;
+    }
+    // Wait for a second of audio to know the PCM rate of the stream.
+    uint64_t elapsed_us = now_us > start_us ? now_us - start_us : 0;
+    if (start_us == 0 || elapsed_us < 1000000 || session_bytes == 0) {
+      return;
+    }
+    uint64_t queue_delay = queued_bytes * elapsed_us / session_bytes / 100;
+    uint64_t delay = btif_av_get_audio_delay(A2dpType::kSource) + queue_delay;
+    delay = std::min<uint64_t>(delay, UINT16_MAX);
+    uint64_t diff = delay > last_reported_ ? delay - last_reported_ : last_reported_ - delay;
+    if (diff < 50) {  // 5 ms
+      return;
+    }
+    last_reported_ = delay;
+    bluetooth::audio::a2dp::set_remote_delay(static_cast<uint16_t>(delay));
+  }
+
+private:
+  std::mutex mutex_;
+  std::deque<uint32_t> pcm_bytes_;  // PCM bytes behind each queued packet
+  uint64_t queued_bytes_ = 0;
+  uint64_t session_bytes_ = 0;
+  uint64_t session_start_us_ = 0;
+  uint64_t last_reported_ = 0;
+};
+
+static TxQueueDelay btif_a2dp_source_tx_queue_delay;
+
 static void btif_a2dp_source_init_delayed(void);
 static bool btif_a2dp_source_startup(void);
 static void btif_a2dp_source_startup_delayed(void);
@@ -580,6 +658,7 @@ void btif_a2dp_source_shutdown(std::promise<void> shutdown_complete_promise) {
 
   fixed_queue_free(btif_a2dp_source_cb.tx_audio_queue, nullptr);
   btif_a2dp_source_cb.tx_audio_queue = nullptr;
+  btif_a2dp_source_tx_queue_delay.Clear();
 
   btif_a2dp_source_cb.SetState(BtifA2dpSource::kStateOff);
 
@@ -866,6 +945,7 @@ static void btif_a2dp_source_audio_tx_start_event(void) {
 
   wakelock_acquire();
   btif_a2dp_source_cb.encoder_interface->feeding_reset();
+  btif_a2dp_source_tx_queue_delay.StartSession(bluetooth::common::time_get_os_boottime_us());
   btif_a2dp_source_cb.tx_flush = false;
   btif_a2dp_source_cb.sw_audio_is_encoding = true;
   btif_a2dp_source_cb.media_alarm.SchedulePeriodic(
@@ -945,6 +1025,7 @@ static void btif_a2dp_source_audio_handle_timer(void) {
   }
 
   btif_a2dp_source_cb.encoder_interface->send_frames(timestamp_us);
+  btif_a2dp_source_tx_queue_delay.Report(stats_timestamp_us);
 
   bta_av_ci_src_data_ready(BTA_AV_CHNL_AUDIO);
   update_scheduling_stats(&btif_a2dp_source_cb.stats.tx_queue_enqueue_stats, stats_timestamp_us,
@@ -975,7 +1056,7 @@ static uint32_t btif_a2dp_source_read_callback(uint8_t* p_buf, uint32_t len) {
 /// Callback invoked by the encoder for sending encoded audio frames to the
 /// remote Bluetooth device. Runs on the source worker thread.
 static bool btif_a2dp_source_enqueue_callback(BT_HDR* p_buf, size_t frames_n,
-                                              uint32_t /*bytes_read*/) {
+                                              uint32_t bytes_read) {
   uint64_t now_us = bluetooth::common::time_get_os_boottime_us();
 
   // Check if the transmission queue has been flushed.
@@ -986,6 +1067,7 @@ static bool btif_a2dp_source_enqueue_callback(BT_HDR* p_buf, size_t frames_n,
             fixed_queue_length(btif_a2dp_source_cb.tx_audio_queue);
     btif_a2dp_source_cb.stats.tx_queue_last_flushed_us = now_us;
     fixed_queue_flush(btif_a2dp_source_cb.tx_audio_queue, osi_free);
+    btif_a2dp_source_tx_queue_delay.Clear();
 
     osi_free(p_buf);
     return false;
@@ -1018,6 +1100,7 @@ static bool btif_a2dp_source_enqueue_callback(BT_HDR* p_buf, size_t frames_n,
         osi_free(p_data);
       }
     }
+    btif_a2dp_source_tx_queue_delay.Clear();
     bluetooth::metrics::LogMetricA2dpAudioOverrunEvent(
             btif_av_source_active_peer(), btif_a2dp_source_cb.encoder_interval_ms, drop_n,
             num_dropped_encoded_frames, num_dropped_encoded_bytes);
@@ -1028,6 +1111,7 @@ static bool btif_a2dp_source_enqueue_callback(BT_HDR* p_buf, size_t frames_n,
   btif_a2dp_source_cb.stats.tx_queue_max_frames_per_packet =
           std::max(frames_n, btif_a2dp_source_cb.stats.tx_queue_max_frames_per_packet);
 
+  btif_a2dp_source_tx_queue_delay.Enqueued(bytes_read);
   fixed_queue_enqueue(btif_a2dp_source_cb.tx_audio_queue, p_buf);
 
   return true;
@@ -1049,6 +1133,7 @@ static void btif_a2dp_source_audio_tx_flush_event(void) {
           fixed_queue_length(btif_a2dp_source_cb.tx_audio_queue);
   btif_a2dp_source_cb.stats.tx_queue_last_flushed_us = bluetooth::common::time_get_os_boottime_us();
   fixed_queue_flush(btif_a2dp_source_cb.tx_audio_queue, osi_free);
+  btif_a2dp_source_tx_queue_delay.Clear();
 }
 
 static bool btif_a2dp_source_audio_tx_flush_req(void) {
@@ -1065,6 +1150,7 @@ BT_HDR* btif_a2dp_source_audio_readbuf(void) {
   btif_a2dp_source_cb.stats.tx_queue_total_readbuf_calls++;
   btif_a2dp_source_cb.stats.tx_queue_last_readbuf_us = now_us;
   if (p_buf != nullptr) {
+    btif_a2dp_source_tx_queue_delay.Dequeued();
     // Update the statistics
     update_scheduling_stats(&btif_a2dp_source_cb.stats.tx_queue_dequeue_stats, now_us,
                             btif_a2dp_source_cb.encoder_interval_ms * 1000);
