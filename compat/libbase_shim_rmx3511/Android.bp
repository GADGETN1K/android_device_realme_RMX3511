//
// S blobs (Mali gralloc allocator/mapper and others) import explicit
// libbase template instantiations that newer libbase no longer exports.

cc_library_shared {
    name: "libbase_shim_rmx3511",
    vendor: true,
    srcs: ["libbase_shim_rmx3511.cpp"],
    shared_libs: ["libbase"],
    compile_multilib: "both",
}
