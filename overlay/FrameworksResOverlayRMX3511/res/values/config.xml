    <!-- Display cutout: the waterdrop notch, from stock framework-res
         (pixels, top centre). Stock has no rounded corner radius. -->
    <string name="config_mainBuiltInDisplayCutout" translatable="false">M -38,0 L -38,64 L 38,64 L 38,0 Z</string>
    <string name="config_mainBuiltInDisplayCutoutRectApproximation" translatable="false">@string/config_mainBuiltInDisplayCutout</string>
    <bool name="config_fillMainBuiltInDisplayCutout">false</bool>

    <!-- Status bar height, from stock framework-res -->
    <dimen name="status_bar_height_default">48dp</dimen>
    <dimen name="status_bar_height_portrait">48dp</dimen>
    <dimen name="quick_qs_offset_height">48dp</dimen>

    <!-- Display: 60 Hz panel -->
    <integer name="config_defaultPeakRefreshRate">60</integer>
    <integer name="config_defaultRefreshRateInZone">60</integer>
    <bool name="config_setColorTransformAccelerated">true</bool>

    <!-- Power -->
    <bool name="config_enableAutoPowerModes">true</bool>
    <bool name="config_suspendWhenScreenOffDueToProximity">true</bool>
    <bool name="config_zramWriteback">true</bool>
    <bool name="config_unplugTurnsOnScreen">true</bool>

    <!-- Input / navigation -->
    <bool name="config_showNavigationBar">true</bool>
    <bool name="config_swipe_up_gesture_setting_available">true</bool>
    <integer name="config_overrideHasPermanentMenuKey">2</integer>
    <bool name="config_cameraDoubleTapPowerGestureEnabled">true</bool>
    <bool name="config_useDevInputEventForAudioJack">true</bool>
    <bool name="config_intrusiveNotificationLed">true</bool>
    <integer name="config_notificationsBatteryMediumARGB">0xFFFF0000</integer>
    <integer-array name="config_longPressVibePattern">
        <item>0</item>
        <item>30</item>
    </integer-array>

    <!-- Biometrics: one strong fingerprint sensor (stock also lists face).
         It sits in the power button on the right side; without this the
         HIDL sensor is reported as a rear one. -->
    <bool name="config_is_powerbutton_fps">true</bool>
    <!-- Where the side sensor is, in pixels in natural orientation, for the
         sensor indicator and the unlock animation: "displayId,x,y,radius"
         (empty displayId = default display). Measured with pointer location:
         the button spans y 955-1126 at the right edge. -->
    <string-array name="config_sfps_sensor_props" translatable="false">
        <item>,1080,1040,86</item>
    </string-array>
    <string-array name="config_biometric_sensors" translatable="false">
        <item>0:2:15</item>
    </string-array>

