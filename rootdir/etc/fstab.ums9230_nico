# Android fstab file.
# Based on stock RMX3511_13.F.54 vendor_boot (first_stage_ramdisk/fstab.ums9230_nico
# + system/etc/recovery.fstab). Dynamic partitions are erofs on stock; ext4
# lines are kept as fallback so either filesystem can be built.
#
# DEBUG (temporary, bring-up only): no avb flags on the dynamic partitions,
# so no dm-verity until the hashtree mismatch on /system is understood.
#
# <src>                    <mnt_point>       <type> <mnt_flags and options>                                     <fs_mgr_flags>
system                     /system           erofs  ro                                                          wait,logical,first_stage_mount,slotselect
system                     /system           ext4   ro,barrier=1                                                wait,logical,first_stage_mount,slotselect
system_ext                 /system_ext       erofs  ro                                                          wait,logical,first_stage_mount,slotselect
system_ext                 /system_ext       ext4   ro,barrier=1                                                wait,logical,first_stage_mount,slotselect
product                    /product          erofs  ro                                                          wait,logical,first_stage_mount,slotselect
product                    /product          ext4   ro,barrier=1                                                wait,logical,first_stage_mount,slotselect
vendor                     /vendor           erofs  ro                                                          wait,logical,first_stage_mount,slotselect
vendor                     /vendor           ext4   ro,barrier=1                                                wait,logical,first_stage_mount,slotselect
vendor_dlkm                /vendor_dlkm      erofs  ro                                                          wait,logical,first_stage_mount,slotselect
vendor_dlkm                /vendor_dlkm      ext4   ro,barrier=1                                                wait,logical,first_stage_mount,slotselect

/dev/block/by-name/metadata /metadata        ext4   nodev,noatime,nosuid,errors=panic                           wait,formattable,first_stage_mount,check
/dev/block/by-name/userdata /data            f2fs   noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,inline_xattr,inline_data,inlinecrypt,fsync_mode=nobarrier latemount,wait,check,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,reservedsize=128M,checkpoint=fs,formattable
/dev/block/by-name/cache   /cache            ext4   noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc       wait,check
/dev/block/by-name/cache   /cache            f2fs   noatime,nosuid,nodev,discard                                wait,check
# prodnv holds per-device calibration used by RIL/WCN — mount only, never write images to it
/dev/block/by-name/prodnv  /mnt/vendor       ext4   noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc       wait,check

# Raw partitions (used by recovery/update_engine)
/dev/block/by-name/boot    /boot             emmc   defaults                                                    slotselect
/dev/block/by-name/dtbo    /dtbo             emmc   defaults                                                    slotselect
/dev/block/by-name/vbmeta  /vbmeta           emmc   defaults                                                    slotselect
/dev/block/by-name/vbmeta_system /vbmeta_system emmc defaults                                                   slotselect
/dev/block/by-name/misc    /misc             emmc   defaults                                                    defaults

# External storage (sysfs paths from stock vendor/etc/fstab.ums9230_nico)
/devices/platform/soc/soc:ap-apb/201a0000.sdio/mmc_host/mmc1/mmc1:*/block/mmcblk1 auto auto defaults voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/soc/soc:aon/64900000.usb/musb-hdrc.*.auto/usb* auto auto defaults voldmanaged=usbdisk:auto
