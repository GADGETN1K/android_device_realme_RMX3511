# vendor properties for RMX3511

# Display
ro.sf.lcd_density=480

# Display enhancement (PQ). hwcomposer waits for the enhance HAL on every
# present, so it must come up. It used to crash parsing its XML configs
# with Android 16's tinyxml2 (see compat/libtxml2v31); with the VNDK v31
# one it runs with all modules enabled, like stock.

# USB: device-mode controller (MUSB). init.ums9230_nico.usb.rc and the
# recovery USB setup write it to the gadget's UDC; without it neither adb
# nor sideload come up. Our kernel registers the MUSB device as
# musb-hdrc.1.auto (stock's says .0), see /sys/class/udc.
sys.usb.controller=musb-hdrc.1.auto
# configfs gadget. Also read by recovery (prop.default), whose init.rc only
# sets up the configfs gadget when this is 1.
sys.usb.configfs=1

# Bluetooth: the Unisoc HCI HAL aborts ("No Bluetooth Address!") unless it
# can read the address from here (stock vendor/build.prop).
ro.bt.bdaddr_path=/data/vendor/bluetooth/btmac.txt
# libbt-vendor loads bt_configure_{pskey,rf}*.ini from here (default
# /system/etc). Without them the controller comes up unconfigured, reports
# no SSP and the stack aborts in btm_sec_dev_reset.
ro.vendor.wcn.hardware.etcpath=/vendor/firmware

# Radio / modem (from stock vendor/build.prop). Dual SIM, LTE modem "l".
persist.radio.multisim.config=dsds
persist.vendor.radio.phone_count=2
persist.vendor.radio.imsua.setting=1
ro.telephony.default_network=9
ro.vendor.radio.fallback.enable=true
ro.vendor.radio.modemtype=l
persist.vendor.modem.l.enable=1
persist.vendor.modem.log_dest=0
persist.vendor.modem.nvp=l_
persist.vendor.sys.modem.diag=,vser
persist.vendor.sys.modem.save_dump=1
persist.vendor.sys.modemreset=1
ro.vendor.modem.assert=/dev/spipe_lte2
ro.vendor.modem.dev=/proc/cptl/
ro.vendor.modem.diag=/dev/sdiag_lte
ro.vendor.modem.eth=seth_lte
ro.vendor.modem.fixnv_size=0x100000
ro.vendor.modem.gnss.diag=/dev/wcn_gnss_dump
ro.vendor.modem.gnss.log=/dev/slog_gnss
ro.vendor.modem.log=/dev/slog_lte
ro.vendor.modem.loop=/dev/spipe_lte0
ro.vendor.modem.nv=/dev/spipe_lte1
ro.vendor.modem.runnv_size=0x120000
ro.vendor.modem.snd=1
ro.vendor.modem.support=1
ro.vendor.modem.tmctl=/dev/sprd_time_sync
ro.vendor.modem.tmtsf=/dev/stime_pm
ro.vendor.modem.tty=/dev/stty_lte
ro.vendor.modem.wcn.count=1
ro.vendor.modem.wcn.diag=/dev/slog_wcn0
ro.vendor.modem.wcn.enable=1
ro.vendor.modem.wcn.id=1

# Bluetooth profiles and A2DP offload (stock)
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.map.server.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.pbap.server.enabled=true
persist.bluetooth.a2dp_offload.cap=sbc
persist.bluetooth.a2dp_offload.switch=false
ro.bluetooth.a2dp_offload.supported=true
persist.bluetooth.a2dp_offload.disabled=true

# Camera HAL tuning (stock)
camera.disable_zsl_mode=1
ro.vendor.camera.dualcamera_cali_time=3
persist.vendor.cam.back.high.cap=50M
persist.vendor.cam.blur.cov.id=3
persist.vendor.cam.fdr.sel=0
persist.vendor.cam.3dnr.version=1
persist.vendor.cam.ba.blur.version=1
persist.vendor.cam.fr.blur.version=1
persist.vendor.cam.res.blur.ba=RES_12M
persist.vendor.cam.macrophoto.enable=1
persist.vendor.cam.hdr.cnr.mode=1
persist.vendor.cam.sensitivityRange.id0=50,1600
persist.vendor.cam.fast.automode=true
persist.vendor.cam.fd.enable=true
persist.vendor.cam.blur.fast.thumb=1567
persist.vendor.cam.auto.fast.thumb=1567
persist.vendor.cam.ee.mode=1
persist.vendor.cam.multi.camera.enable=0
persist.vendor.cam.video.face.beauty.enable=0
persist.vendor.cam.dual.view.video.enable=0
persist.vendor.cam.dv.ba.eispro.enable=1
persist.vendor.cam.vd_blurless.support=1
persist.vendor.cam.night.pro.enable=1
persist.vendor.cam.ip.eis.pro=0
persist.vendor.cam.ev.20.enable=1
persist.vendor.cam.ba.portrait.enable=1
persist.vendor.cam.fr.portrait.enable=0
persist.vendor.cam.lpt.level.enable=1
persist.vendor.cam.lightportrait.fr.enable=0
persist.vendor.cam.fov.fusion.enable=0
persist.vendor.cam.ip.wtfusion.pro=0
persist.vendor.cam.record.fps=3025
persist.vendor.cam.hdr.version=2
persist.vendor.cam.shutteranimation.enable=false
ro.vendor.camera.dualcamera_cali_enable=1
persist.vendor.cam.api.version=0
persist.vendor.cam.res.bokeh=RES_8M
persist.vendor.cam.multicam.cali.veri=1
persist.vendor.cam.opticszoom.cali.mode=3
persist.vendor.cam.focus.distance=300
persist.vendor.cam.facebeauty.corp=2
persist.vendor.cam.cnr.mode=1
persist.vendor.cam.fdr.enable=2
persist.vendor.cam.ai.scence.enable=2
persist.vendor.cam.wt.enable=0
persist.vendor.cam.hdr.zsl=1
persist.vendor.cam.res.multi.camera=RES_MULTI
persist.vendor.cam.multi.section=3
persist.vendor.cam.dcam.mipi.raw.align=16
persist.vendor.cam.ultra.wide.enable=1
vendor.cam.hw.framesync.on=0
persist.vendor.cam.sprdUltraDistortionCorrectEnable=1
persist.vendor.cam.lightportrait.ba.enable=1
persist.vendor.cam.singleportrait.hdmf=3
persist.vendor.cam.bokeh.hdmf=3
persist.vendor.cam.nightpro.hdr.mfnr.enable=0
persist.vendor.cam.faceid.version=1
persist.vendor.cam.ip.switch.on=0

# SurfaceFlinger (stock)
ro.surface_flinger.vsync_event_phase_offset_ns=1000000
ro.surface_flinger.vsync_sf_event_phase_offset_ns=1000000
ro.surface_flinger.use_context_priority=true
ro.surface_flinger.has_wide_color_display=false
ro.surface_flinger.has_HDR_display=false
ro.surface_flinger.present_time_offset_from_vsync_ns=0
ro.surface_flinger.force_hwc_copy_for_virtual_displays=false
ro.surface_flinger.max_virtual_display_dimension=0
ro.surface_flinger.running_without_sync_framework=false
ro.surface_flinger.use_vr_flinger=false
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.start_graphics_allocator_service=false
ro.surface_flinger.primary_display_orientation=ORIENTATION_0
ro.surface_flinger.set_display_power_timer_ms=1000
ro.surface_flinger.support_kernel_idle_timer=true
debug.sf.treat_170m_as_sRGB=1
ro.surface_flinger.set_idle_timer_ms=4000
ro.surface_flinger.set_touch_timer_ms=200
ro.surface_flinger.use_content_detection_for_refresh_rate=true
debug.sf.latch_unsignaled=1

# WCN: Wi-Fi/BT/GNSS combo chip (stock)
persist.vendor.gnss.notification.enable=1
persist.vendor.gnss.supl_ni.enable=1
persist.sys.wifi.reset.devpath=devices/platform/sprd-marlin3/sprd-marlin3:wlan
ro.vendor.ko.mount.point=/mnt/vendor
persist.vendor.wcn.log_dest=0
persist.vendor.sys.wcnreset=1
persist.vendor.sys.wcnstate=0
ro.vendor.gnsschip=marlin3lite
ro.vendor.wcn.gpschip=marlin3lite
ro.vendor.wcn.hardware.product=marlin3_lite

# Modem/DSP log devices and IMS (stock)
ro.vendor.ldsp.log=/dev/slog_ldsp
ro.vendor.sp.dev=/proc/pmic/
ro.vendor.sp.log=/dev/slog_pm
ro.vendor.ag.log=/dev/audio_dsp_log
ro.vendor.ag.pcm=/dev/audio_dsp_pcm
ro.vendor.ag.mem=/dev/audio_dsp_mem
ro.vendor.product.partitionpath=/dev/block/by-name/
persist.vendor.sys.single.imsstack=true
persist.vendor.sys.volte.enable=true

# Audio (stock)
ro.vendor.audio.whale_hal=true
persist.audio.hifi_enabled=false
ro.audio.offload_wakelock=false

# Graphics, display and media (stock)
ro.vendor.gpu.boost=0
ro.opengles.version=196610
ro.vendor.display.sr=true
persist.vendor.bsservice.enable=1
graphics.gpu.profiler.support=true
persist.vendor.powerhint.hint.enable=true
ro.vendor.media.wfd.resolution=2
media.stagefright.thumbnail.prefer_hw_codecs=true
drm.service.enabled=true

# Backlight (stock). The lights HAL reads it, but still writes the
# framework's 0-255 as is; the kernel's sprd_bl takes 0-255 for that.
persist.vendor.bl.max=4095

# NFC, zram (stock). ro.frp.pst left out on purpose: it points FRP at the
# persist partition, which we never touch.
ro.hardware.nfc_nci=pn8x
ro.zram.mark_idle_delay_mins=60
ro.zram.first_wb_delay_mins=180
ro.zram.periodic_wb_delay_hours=24
