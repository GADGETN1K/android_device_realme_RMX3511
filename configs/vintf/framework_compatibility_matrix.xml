<!-- Unisoc vendor HIDL HALs from the stock vendor manifest. On stock the
     Unisoc system_ext declared them; our system is AOSP, so declare them
     here as optional. -->
<compatibility-matrix version="2.0" type="framework">
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.ai_engine</name>
        <version>1.0</version>
        <interface>
            <name>IAIEngineControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.aprd</name>
        <version>1.0</version>
        <interface>
            <name>IAprdInfoSync</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.commondcs</name>
        <version>1.0</version>
        <interface>
            <name>ICommonDcsHalService</name>
            <instance>commondcsservice</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
        <name>vendor.sprd.hardware.connmgr</name>
        <version>1.0</version>
        <interface>
            <name>IConnmgr</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl" optional="true">
