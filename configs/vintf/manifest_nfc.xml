<!-- NFC HAL: android.hardware.nfc@1.2-service built from
     hardware/nxp/nfc/pn8x (PN557, /dev/nq-nci). The OSS service has no
     vintf_fragments, so it is declared here. -->
<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>android.hardware.nfc</name>
        <transport>hwbinder</transport>
        <fqname>@1.2::INfc/default</fqname>
    </hal>
</manifest>
