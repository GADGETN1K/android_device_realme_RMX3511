# Hand-written rules on top of the generated stock_vendor.te, for the
# AOSP/OSS HALs this tree ships and for what the stock policy missed.

# Composer: DRM uevents, allocator and power HAL, vndbinder
allow hal_graphics_composer_default self:netlink_kobject_uevent_socket { create bind read setopt getopt };
hal_client_domain(hal_graphics_composer_default, hal_graphics_allocator)
hal_client_domain(hal_graphics_composer_default, hal_power)
vndbinder_use(hal_graphics_composer_default)
get_prop(hal_graphics_composer_default, graphics_config_prop)
allow hal_graphics_composer_default block_device:dir search;

# Camera
vndbinder_use(hal_camera_default)
allow hal_camera_default hardwareinfo_device:chr_file rw_file_perms;

# Health: the stock policy labels the charger-manager power_supply nodes
# sysfs_power
r_dir_file(hal_health_default, sysfs_power)

# Lights: LED and panel backlight sysfs nodes
allow hal_light_default sysfs_leds:dir r_dir_perms;
allow hal_light_default sysfs_leds:file rw_file_perms;

# Vibrator (stock Unisoc HAL drives an input force-feedback device)
allow hal_vibrator_default input_device:dir r_dir_perms;
allow hal_vibrator_default input_device:chr_file rw_file_perms;

# Sensors
allow hal_sensors_default iio_device:chr_file rw_file_perms;

# Fingerprint: netlink to the sensor driver
allow hal_fingerprint_default self:netlink_socket create_socket_perms_no_ioctl;

# Enhance (PQ) HAL reads its tables from /mnt/vendor/enhance
allow hal_enhance_default prod_file:dir r_dir_perms;
allow hal_enhance_default prod_file:file rw_file_perms;

# Boot control / misc readers: the misc partition
allow { hal_bootctl_default } misc_block_device:blk_file rw_file_perms;

# --- round 2 ---

# Health: the SGM4154x charger's power_supply node
# (labelled sysfs_batteryinfo in genfs_contexts)

# Power HAL (stock Unisoc): CPU frequency floors, VM watermarks, uclamp
allow hal_power_default sysfs_devices_system_cpu:file rw_file_perms;
allow hal_power_default proc_watermark_scale_factor:file rw_file_perms;
allow hal_power_default cgroup:file r_file_perms;

# RIL: also serves android.hardware.secure_element (SIM1/SIM2)
hal_server_domain(rild, hal_secure_element)
get_prop(rild, vendor_radio_dataonly_prop)
set_prop(rild, vendor_radio_prop)
allow rild proc_cmdline:file r_file_perms;

# Fingerprint
set_prop(hal_fingerprint_default, vendor_sys_prop)
type proc_fp_id, fs_type, proc_type;
allow hal_fingerprint_default proc_fp_id:file r_file_perms;

# Composer
get_prop(hal_graphics_composer_default, graphics_config_writable_prop)
get_prop(hal_graphics_composer_default, boot_status_prop)

# Camera: sensor name node
allow hal_camera_default sysfs_sensor:file rw_file_perms;

# Lights also toggles the touch panel suspend node
# (ts_suspend is labelled sysfs_leds in genfs_contexts)

# refnotify reads the backlight level
allow refnotify sysfs_leds:dir search;
allow refnotify sysfs_leds:file r_file_perms;

# Audio HAL
allow hal_audio_default mnt_vendor_file:dir search;

# Unisoc storage proxy (tee domain)
allow tee self:capability { setuid setgid sys_rawio };
allow tee block_device:dir search;

# Module loading flags
set_prop(vendor_init, vendor_device_prop)
set_prop(vendor_modprobe, vendor_device_prop)
set_prop(vendor_init, vendor_display_prop)

# --- round 3 ---

# Sensors: the sensorhub iio device and its sysfs nodes
allow hal_sensors_default sysfs_sensor:dir r_dir_perms;
allow hal_sensors_default sysfs_sensor:file rw_file_perms;
allow hal_sensors_default sysfs_sensor:lnk_file read;

# Camera walks /sys/devices/virtual/misc/sprd_sensor
allow hal_camera_default sysfs_sensor:dir search;

# --- round 4 ---

# init.modules.sh (vendor_modprobe service) loads the vendor_dlkm modules
type rmx3511_modules_sh_exec, exec_type, vendor_file_type, file_type;
allow vendor_modprobe rmx3511_modules_sh_exec:file { entrypoint r_file_perms execute };
allow vendor_modprobe vendor_toolbox_exec:file execute_no_trans;
allow vendor_modprobe self:capability sys_nice;
allow vendor_modprobe kernel:process setsched;

# Wi-Fi HAL: driver private ioctl (SIOCDEVPRIVATE + 8)
allow hal_wifi_default self:udp_socket ioctl;
allowxperm hal_wifi_default self:udp_socket ioctl 0x89f8;

# Fingerprint (Silead) cleans up its verify directory
allow hal_fingerprint_default silead_fpd_data_file:dir rmdir;

# Harmless: processes probing vendor props they have no business reading,
# and init starting vendor services with AT_SECURE.
dontaudit { appdomain bootanim surfaceflinger audioserver mediaswcodec mediaserver } vendor_default_prop:file r_file_perms;
dontaudit mediaserver vendor_sys_prop:file r_file_perms;
dontaudit init domain:process noatsecure;
